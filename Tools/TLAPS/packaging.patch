diff --git a/deps/ls4/Makefile b/deps/ls4/Makefile
index 6c40935..ce0311b 100644
--- a/deps/ls4/Makefile
+++ b/deps/ls4/Makefile
@@ -1,7 +1,9 @@
 OS_TYPE=$(patsubst CYGWIN%,Cygwin,$(shell uname))
 
 LS4_VERS=1.0
-LS4_URL_PREFIX=https://github.com/quickbeam123/ls4/archive
+LS4_COMMIT=f7383bd5d3f1c1e9399a23a16e7f12f8153d41e5
+LS4_URL=https://codeload.github.com/quickbeam123/ls4/zip/$(LS4_COMMIT)
+LS4_SHA256=08673e8720d8d59171a8fe5f86e37687a9c492c0d59b01971a1a90e5c4050b9a
 LS4_BASE_NAME=ls4-$(LS4_VERS)
 
 ifeq ($(OS_TYPE),Linux)
@@ -17,11 +19,13 @@ endif
 all: ls4
 
 v$(LS4_VERS).zip:
-	wget --progress=dot:giga $(LS4_URL_PREFIX)/$@
+	wget --progress=dot:giga $(LS4_URL) -O $@
+	echo '$(LS4_SHA256)  $@' | shasum -a 256 -c -
 
 $(LS4_BASE_NAME): v$(LS4_VERS).zip
 	rm -rf $@
 	unzip $<
+	mv ls4-$(LS4_COMMIT) $@
 	touch $@ # To avoid rebuilds.
 	( set -x && patch -p0 <ls4.patch )
 	cd $(LS4_BASE_NAME)/core && cc -c aiger.c
