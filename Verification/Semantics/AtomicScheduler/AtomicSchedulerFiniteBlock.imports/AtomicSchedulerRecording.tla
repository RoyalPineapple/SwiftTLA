SchedulerRecordingResultName == <<114, 101, 115, 117, 108, 116>>
SchedulerRecordingSelfName == <<115, 101, 108, 102>>
SchedulerRecordingTargetField == <<116, 97, 114, 103, 101, 116>>
SchedulerRecordingLastWriteField == <<108, 97, 115, 116, 87, 114, 105, 116, 101>>

SchedulerRecordingNames ==
    [param |-> SchedulerInputSlice(35541, 6),
     copyName |-> SchedulerInputSlice(35604, 6),
     seed |-> SchedulerInputSlice(35613, 4),
     mapReceiver |-> SchedulerInputSlice(35630, 6),
     mapField |-> SchedulerInputSlice(35637, 8),
     keyReceiver |-> SchedulerInputSlice(35646, 6),
     keyField |-> SchedulerInputSlice(35653, 6),
     binderReceiver |-> SchedulerInputSlice(35673, 6),
     binderField |-> SchedulerInputSlice(35680, 7),
     lastReceiver |-> SchedulerInputSlice(35701, 6),
     lastField |-> SchedulerInputSlice(35708, 9),
     lastValue |-> SchedulerInputSlice(35720, 6),
     returnValue |-> SchedulerInputSlice(35746, 6)]

THEOREM ActualSchedulerRecordingNameUses ==
    /\ SchedulerRecordingNames.param = SchedulerNameUpdate
    /\ SchedulerRecordingNames.copyName = SchedulerRecordingResultName
    /\ SchedulerRecordingNames.seed = SchedulerRecordingSelfName
    /\ SchedulerRecordingNames.mapReceiver = SchedulerRecordingResultName
    /\ SchedulerRecordingNames.mapField = SchedulerRootBindingsField
    /\ SchedulerRecordingNames.keyReceiver = SchedulerNameUpdate
    /\ SchedulerRecordingNames.keyField = SchedulerRecordingTargetField
    /\ SchedulerRecordingNames.binderReceiver = SchedulerNameUpdate
    /\ SchedulerRecordingNames.binderField = SchedulerNameBinding
    /\ SchedulerRecordingNames.lastReceiver = SchedulerRecordingResultName
    /\ SchedulerRecordingNames.lastField = SchedulerRecordingLastWriteField
    /\ SchedulerRecordingNames.lastValue = SchedulerNameUpdate
    /\ SchedulerRecordingNames.returnValue = SchedulerRecordingResultName
PROOF
<1>paramUse. SchedulerInputSlice(35541, 6) = SchedulerNameUpdate
    BY ONLY SchedulerRecordingChunk2215, SMT DEF SchedulerInputSlice, SchedulerNameUpdate
<1>copyNameUse. SchedulerInputSlice(35604, 6) = SchedulerRecordingResultName
    BY ONLY SchedulerRecordingChunk2219, SMT DEF SchedulerInputSlice, SchedulerRecordingResultName
<1>seedUse. SchedulerInputSlice(35613, 4) = SchedulerRecordingSelfName
    BY ONLY SchedulerRecordingChunk2219, SchedulerRecordingChunk2220, SMT DEF SchedulerInputSlice, SchedulerRecordingSelfName
<1>mapReceiverUse. SchedulerInputSlice(35630, 6) = SchedulerRecordingResultName
    BY ONLY SchedulerRecordingChunk2220, SchedulerRecordingChunk2221, SMT DEF SchedulerInputSlice, SchedulerRecordingResultName
<1>mapFieldUse. SchedulerInputSlice(35637, 8) = SchedulerRootBindingsField
    BY ONLY SchedulerRecordingChunk2221, SMT DEF SchedulerInputSlice, SchedulerRootBindingsField
<1>keyReceiverUse. SchedulerInputSlice(35646, 6) = SchedulerNameUpdate
    BY ONLY SchedulerRecordingChunk2221, SchedulerRecordingChunk2222, SMT DEF SchedulerInputSlice, SchedulerNameUpdate
<1>keyFieldUse. SchedulerInputSlice(35653, 6) = SchedulerRecordingTargetField
    BY ONLY SchedulerRecordingChunk2222, SMT DEF SchedulerInputSlice, SchedulerRecordingTargetField
<1>binderReceiverUse. SchedulerInputSlice(35673, 6) = SchedulerNameUpdate
    BY ONLY SchedulerRecordingChunk2223, SMT DEF SchedulerInputSlice, SchedulerNameUpdate
<1>binderFieldUse. SchedulerInputSlice(35680, 7) = SchedulerNameBinding
    BY ONLY SchedulerRecordingChunk2224, SMT DEF SchedulerInputSlice, SchedulerNameBinding
<1>lastReceiverUse. SchedulerInputSlice(35701, 6) = SchedulerRecordingResultName
    BY ONLY SchedulerRecordingChunk2225, SMT DEF SchedulerInputSlice, SchedulerRecordingResultName
<1>lastFieldUse. SchedulerInputSlice(35708, 9) = SchedulerRecordingLastWriteField
    BY ONLY SchedulerRecordingChunk2225, SchedulerRecordingChunk2226, SMT DEF SchedulerInputSlice, SchedulerRecordingLastWriteField
<1>lastValueUse. SchedulerInputSlice(35720, 6) = SchedulerNameUpdate
    BY ONLY SchedulerRecordingChunk2226, SMT DEF SchedulerInputSlice, SchedulerNameUpdate
<1>returnValueUse. SchedulerInputSlice(35746, 6) = SchedulerRecordingResultName
    BY ONLY SchedulerRecordingChunk2228, SMT DEF SchedulerInputSlice, SchedulerRecordingResultName
<1>. QED BY ONLY <1>paramUse, <1>copyNameUse, <1>seedUse, <1>mapReceiverUse,
    <1>mapFieldUse, <1>keyReceiverUse, <1>keyFieldUse, <1>binderReceiverUse,
    <1>binderFieldUse, <1>lastReceiverUse, <1>lastFieldUse, <1>lastValueUse,
    <1>returnValueUse
    DEF SchedulerRecordingNames


\* Swift copy and member/subscript assignment use value semantics. Optional.some
\* for lastWrite is represented directly as its descriptor, as in the caller.
\* The known target property of ScheduledAtomicBindingWrite projects .target;
\* its binding property uses the same byte-keyed field as the caller.
SchedulerRecordingMember(descriptor, key) ==
    IF key = SchedulerRecordingTargetField THEN descriptor.target ELSE descriptor[key]

ActualSchedulerRecordingResult(incoming, descriptor) ==
    LET n == SchedulerRecordingNames
        entry == SchedulerWriteLocal([k \in {SchedulerRecordingSelfName} |-> incoming], n.param, descriptor)
        copied == SchedulerWriteLocal(entry, n.copyName, entry[n.seed])
        target == SchedulerRecordingMember(copied[n.keyReceiver], n.keyField)
        binder == SchedulerRecordingMember(copied[n.binderReceiver], n.binderField)
        receiver == copied[n.mapReceiver]
        dictionary == SchedulerWriteLocal(receiver[n.mapField], target, [variable |-> binder])
        routed == SchedulerWriteLocal(copied, n.mapReceiver,
                         SchedulerWriteLocal(receiver, n.mapField, dictionary))
        recorded == SchedulerWriteLocal(routed, n.lastReceiver,
                           SchedulerWriteLocal(routed[n.lastReceiver], n.lastField, routed[n.lastValue]))
    IN recorded[n.returnValue]

THEOREM ActualSchedulerRecordingWritesOnlyTheTarget ==
    ASSUME NEW incoming, SchedulerRootBindingsField \in DOMAIN incoming,
           NEW descriptor, SchedulerNameBinding \in DOMAIN descriptor
    PROVE LET target == descriptor.target
              binding == [variable |-> descriptor[SchedulerNameBinding]]
              mapping == SchedulerWriteLocal(incoming[SchedulerRootBindingsField], target, binding)
              actual == ActualSchedulerRecordingResult(incoming, descriptor)
          IN /\ actual = SchedulerWriteLocal(
                  SchedulerWriteLocal(incoming, SchedulerRootBindingsField, mapping),
                  SchedulerRecordingLastWriteField, descriptor)
             /\ actual[SchedulerRecordingLastWriteField] = descriptor
             /\ actual[SchedulerRootBindingsField] = mapping
             /\ DOMAIN mapping = DOMAIN incoming[SchedulerRootBindingsField] \cup {target}
             /\ \A name \in DOMAIN mapping :
                    mapping[name] = IF name = target THEN binding ELSE incoming[SchedulerRootBindingsField][name]
             /\ \A field \in DOMAIN incoming \ {SchedulerRootBindingsField, SchedulerRecordingLastWriteField} :
                    actual[field] = incoming[field]
PROOF
<1>. DEFINE target == descriptor.target
            binding == [variable |-> descriptor[SchedulerNameBinding]]
            mapping == SchedulerWriteLocal(incoming[SchedulerRootBindingsField], target, binding)
            actual == ActualSchedulerRecordingResult(incoming, descriptor)
            names == SchedulerRecordingNames
<1>distinct. /\ SchedulerRecordingSelfName # SchedulerNameUpdate
              /\ SchedulerRecordingResultName # SchedulerNameUpdate
              /\ SchedulerRecordingTargetField # SchedulerNameBinding
              /\ SchedulerRootBindingsField # SchedulerRecordingLastWriteField
    BY ONLY IsaM("simp"), SMT DEF SchedulerRecordingSelfName, SchedulerNameUpdate, SchedulerRecordingResultName,
        SchedulerRecordingTargetField, SchedulerNameBinding, SchedulerRootBindingsField, SchedulerRecordingLastWriteField
<1>copy. LET scope == SchedulerWriteLocal([k \in {SchedulerRecordingSelfName} |-> incoming], names.param, descriptor)
             copied == SchedulerWriteLocal(scope, names.copyName, scope[names.seed])
         IN /\ copied[names.mapReceiver] = incoming
            /\ copied[names.keyReceiver] = descriptor
            /\ copied[names.binderReceiver] = descriptor
    BY ONLY ActualSchedulerRecordingNameUses, <1>distinct, SMT DEF names, SchedulerWriteLocal
<1>write. LET scope == SchedulerWriteLocal([k \in {SchedulerRecordingSelfName} |-> incoming], names.param, descriptor)
              copied == SchedulerWriteLocal(scope, names.copyName, scope[names.seed])
              routed == SchedulerWriteLocal(copied, names.mapReceiver,
                               SchedulerWriteLocal(incoming, names.mapField, mapping))
          IN /\ routed[names.lastReceiver] = SchedulerWriteLocal(incoming, SchedulerRootBindingsField, mapping)
             /\ routed[names.lastValue] = descriptor
    BY ONLY ActualSchedulerRecordingNameUses, <1>copy, <1>distinct, SMT DEF names, SchedulerWriteLocal
<1>. DEFINE scope == SchedulerWriteLocal([k \in {SchedulerRecordingSelfName} |-> incoming], names.param, descriptor)
            copied == SchedulerWriteLocal(scope, names.copyName, scope[names.seed])
            key == SchedulerRecordingMember(copied[names.keyReceiver], names.keyField)
            binder == SchedulerRecordingMember(copied[names.binderReceiver], names.binderField)
            receiver == copied[names.mapReceiver]
            dictionary == SchedulerWriteLocal(receiver[names.mapField], key, [variable |-> binder])
            routed == SchedulerWriteLocal(copied, names.mapReceiver,
                             SchedulerWriteLocal(receiver, names.mapField, dictionary))
            recorded == SchedulerWriteLocal(routed, names.lastReceiver,
                               SchedulerWriteLocal(routed[names.lastReceiver], names.lastField, routed[names.lastValue]))
<1>operands. /\ key = target /\ [variable |-> binder] = binding
    BY ONLY ActualSchedulerRecordingNameUses, <1>copy, <1>distinct, SMT
        DEF names, scope, copied, key, binder, target, binding, SchedulerRecordingMember
<1>dict. /\ dictionary = mapping /\ receiver = incoming
    BY ONLY ActualSchedulerRecordingNameUses, <1>copy, <1>operands, SMT
        DEF names, scope, copied, receiver, dictionary, mapping
<1>stored. /\ routed[names.lastReceiver] = SchedulerWriteLocal(incoming, SchedulerRootBindingsField, mapping)
            /\ routed[names.lastValue] = descriptor
    BY ONLY <1>write, <1>dict, SMT DEF routed, scope, copied
<1>returned. actual = recorded[names.returnValue]
    BY ONLY DEF actual, ActualSchedulerRecordingResult, names, scope, copied,
                key, binder, receiver, dictionary, routed, recorded
<1>. DEFINE lastValue == SchedulerWriteLocal(routed[names.lastReceiver], names.lastField, routed[names.lastValue])
            mapped == SchedulerWriteLocal(incoming, SchedulerRootBindingsField, mapping)
<1>lastNames. /\ names.lastReceiver = names.returnValue
              /\ names.lastField = SchedulerRecordingLastWriteField
    BY ONLY ActualSchedulerRecordingNameUses, SMT DEF names
<1>lastValue. lastValue = SchedulerWriteLocal(mapped, SchedulerRecordingLastWriteField, descriptor)
    BY ONLY <1>stored, <1>lastNames, SMT DEF lastValue, mapped
<1>storedLast. recorded = SchedulerWriteLocal(routed, names.lastReceiver, lastValue)
    BY ONLY DEF recorded, lastValue
<1>readUpdated. \A environment, field, value :
    SchedulerWriteLocal(environment, field, value)[field] = value
    <2>. TAKE environment, field, value
    <2>key. field \in DOMAIN environment \cup {field}
        BY ONLY SMT
    <2>. QED BY ONLY <2>key, IsaM("(subst fapply, simp, simp)"), SMT DEF SchedulerWriteLocal
<1>absolute. SchedulerWriteLocal(routed, names.lastReceiver, lastValue)[names.lastReceiver] = lastValue
    BY ONLY <1>readUpdated, SMT
<1>readLast. recorded[names.returnValue] = lastValue
    BY ONLY <1>storedLast, <1>lastNames, <1>absolute, SMT
<1>last. recorded[names.returnValue] = SchedulerWriteLocal(
    SchedulerWriteLocal(incoming, SchedulerRootBindingsField, mapping),
    SchedulerRecordingLastWriteField, descriptor)
    BY ONLY <1>readLast, <1>lastValue DEF mapped
<1>result. actual = SchedulerWriteLocal(
    SchedulerWriteLocal(incoming, SchedulerRootBindingsField, mapping),
    SchedulerRecordingLastWriteField, descriptor)
    BY ONLY <1>returned, <1>last
<1>map. /\ DOMAIN mapping = DOMAIN incoming[SchedulerRootBindingsField] \cup {target}
         /\ \A name \in DOMAIN mapping :
                mapping[name] = IF name = target THEN binding ELSE incoming[SchedulerRootBindingsField][name]
    BY ONLY SMT DEF mapping, SchedulerWriteLocal
<1>projection. /\ actual[SchedulerRecordingLastWriteField] = descriptor
                /\ actual[SchedulerRootBindingsField] = mapping
                /\ \A field \in DOMAIN incoming \ {SchedulerRootBindingsField, SchedulerRecordingLastWriteField} :
                       actual[field] = incoming[field]
    BY ONLY <1>result, <1>distinct, SMT DEF SchedulerWriteLocal
<1>. QED BY ONLY <1>result, <1>map, <1>projection DEF actual, mapping, target, binding

====
