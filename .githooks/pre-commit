#!/bin/bash
set -euo pipefail

SWIFTLINT="$(which swiftlint)"
if [ -z "$SWIFTLINT" ]; then
    echo "warning: swiftlint not found, skipping lint check" >&2
    exit 0
fi

staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.swift$' || true)
if [ -z "$staged_files" ]; then
    exit 0
fi

failures=0
while IFS= read -r file; do
    if [ ! -f "$file" ]; then
        continue
    fi
    echo "swiftlint: $file"
    if ! "$SWIFTLINT" lint --config .swiftlint.yml --quiet "$file"; then
        failures=$((failures + 1))
    fi
done <<< "$staged_files"

if [ $failures -ne 0 ]; then
    echo >&2
    echo "swiftlint: ${failures} file(s) had lint issues. Run 'swiftlint --fix' or fix manually." >&2
    exit 1
fi
